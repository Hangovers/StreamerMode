<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>1.0.0.0</Version>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Author>Massimo</Author>
    <Name>Streamer Mode</Name>
    <Punchline>One command to hide every plugin &amp; Dalamud UI element.</Punchline>
    <Description>Hides all plugin windows, all Dalamud windows (settings, installer, log, console, dev menu, title-screen badges) and the Dalamud entries in the system (Escape) menu with a single slash command — controllable ONLY via chat, so nothing on screen reveals you are running plugins. While active it also skips the entire per-frame UI build, reducing the CPU load Dalamud adds.
Usage: /streamer (toggle) | /streamer on | /streamer off | /streamer status</Description>
    <RepoUrl>https://github.com/Hangovers/StreamerMode</RepoUrl>
    <Tags>streamer;streaming;hide;ui;privacy</Tags>
  </PropertyGroup>
</Project>
